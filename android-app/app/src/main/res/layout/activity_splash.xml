<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image (Neon pylons) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bg" />

    <!-- Dark translucent overlay to enhance text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D904091A" />

    <!-- Main Content Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Logo (house bulb icon) -->
            <ImageView
                android:id="@+id/logo_icon"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_logo"
                android:layout_marginBottom="24dp" />

            <!-- Title in Split Color -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart "
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electricity"
                    android:textColor="#00C0FF"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slogan divider -->
            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1A4380" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_connections"
                    app:tint="#FFC107"
                    android:layout_marginHorizontal="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1A4380" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smarter way to monitor &amp; pay"
                android:textColor="#A0B0C5"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="36dp" />

            <!-- Three Feature Points Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_login_card"
                android:backgroundTint="#0C1B3A"
                android:padding="16dp"
                android:layout_marginHorizontal="8dp"
                android:elevation="2dp"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <!-- Point 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_bill_point"
                        app:tint="#00C0FF"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View &amp; Pay\nBills"
                        android:textColor="#E0E6ED"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Divider line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#1A315C" />

                <!-- Point 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_bell_point"
                        app:tint="#00C0FF"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Due-date\nAlerts"
                        android:textColor="#E0E6ED"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Divider line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#1A315C" />

                <!-- Point 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_chart_point"
                        app:tint="#00C0FF"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track Usage\n&amp; Save More"
                        android:textColor="#E0E6ED"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

            <!-- Loading text and progress bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#E0E6ED"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="6dp"
                android:indeterminate="true"
                android:progressTint="#00C0FF"
                android:progressBackgroundTint="#1A315C" />

        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield"
                app:tint="#A0B0C5"
                android:layout_marginRight="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure. Reliable. Smart."
                android:textColor="#A0B0C5"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
