# ==============================================================================
# Smart Electricity Bill Monitoring & Reminder System - Environment Configuration
# ==============================================================================

# Application & Security
JWT_SECRET=super-secret-production-jwt-token-key-change-in-prod-12345
APP_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Real SMS Notification Provider Configuration
# Supported providers: "twilio", "fast2sms", "custom"
# ------------------------------------------------------------------------------
SMS_PROVIDER=fast2sms

# Fast2SMS Configuration (India SMS gateway: https://www.fast2sms.com)
FAST2SMS_API_KEY=

# Twilio Configuration (Global SMS gateway: https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Custom Webhook SMS Gateway (Optional)
CUSTOM_SMS_WEBHOOK_URL=
CUSTOM_SMS_API_KEY=

# ------------------------------------------------------------------------------
# Real Email Notification Provider: Resend (Recommended Transactional API)
# Get a free API key at: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Smart Electricity <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# Alternative Real Email Provider: Standard SMTP (Gmail, Outlook, Amazon SES)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=billing@smartelectricity.com
SMTP_FROM_NAME=Smart Electricity Services
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# Scheduler Settings
# ------------------------------------------------------------------------------
REMINDER_CHECK_INTERVAL_SECONDS=3600
